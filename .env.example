# [AI Providers]
# API credentials and model settings for AI-powered features.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_MAX_TOKENS=2048
TAVILY_API_KEY=

# [Observability]
# Optional tracing settings for monitoring and debugging.
LANGSMITH_API_KEY=
LANGSMITH_TRACING=true
LANGSMITH_PROJECT=orangemango

# [API Authentication]
# Long random bearer token required by POST /message and GET /events.
API_AUTH_TOKEN=replace-with-a-long-random-token

# [API Network]
# Host and container port used by the API service.
API_PORT=8000

# [PostgreSQL]
# Database credentials, network settings, and connection URL.
POSTGRES_DB=orangemango
POSTGRES_USER=orangemango
POSTGRES_PASSWORD=change-me-in-local-env
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql://orangemango:change-me-in-local-env@postgres:5432/orangemango
